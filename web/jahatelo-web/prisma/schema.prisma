// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum MotelStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  SUPERADMIN
  MOTEL_ADMIN
  USER
}

enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  EXPORT
  MANAGE
}

enum ProspectStatus {
  NEW
  CONTACTED
  IN_NEGOTIATION
  WON
  LOST
}

enum ProspectChannel {
  WEB
  APP
  MANUAL
}

enum PaymentType {
  DIRECT_DEBIT
  TRANSFER
  EXCHANGE
}

enum FinancialStatus {
  ACTIVE
  INACTIVE
  DISABLED
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

enum AnalyticsEventType {
  VIEW
  CLICK_PHONE
  CLICK_WHATSAPP
  CLICK_MAP
  CLICK_WEBSITE
  FAVORITE_ADD
  FAVORITE_REMOVE
}

enum AdPlacement {
  POPUP_HOME
  CAROUSEL
  LIST_INLINE
}

enum AdStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum AdEventType {
  VIEW
  CLICK
}

enum PlanType {
  FREE
  BASIC
  GOLD
  DIAMOND
}

enum DayGroup {
  WEEKDAY // Domingo a Jueves
  WEEKEND // Viernes y Sábado
}

/// Día de semana local de Paraguay. Se usa para sobrescrituras puntuales de tarifa.
enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum RoomPriceDuration {
  H1
  H1_5
  H2
  H3
  H12
  H24
  NIGHT
}

enum CodeRepeatRule {
  DAILY
  WEEKLY
  MONTHLY
  NEVER
}

enum CodeLimitPeriod {
  WEEKLY
  MONTHLY
  UNLIMITED
}

enum PromoCodeStatus {
  PENDING
  USED
}

enum MotelReportReason {
  PRICE
  PHOTO
  LOCATION_OR_CONTACT
  CLOSED
  INFORMATION
  OTHER
}

enum MotelReportStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum AppUpdateAction {
  SHOWN
  UPDATE_TAPPED
  DISMISSED
}

// ============================================
// MOTEL
// ============================================

model Motel {
  id                     String      @id @default(cuid())
  name                   String
  slug                   String      @unique
  description            String?
  city                   String
  address                String
  country                String?
  mapUrl                 String?
  googlePlaceId          String?     @unique // Ficha oficial de Google Maps, no el centro del iframe
  latitude               Float?
  longitude              Float?
  phone                  String?
  whatsapp               String?
  website                String?
  instagram              String?
  featuredPhoto          String? // Foto principal/portada del motel
  featuredPhotoWeb       String? // Portada 16:9 para web
  featuredPhotoApp       String? // Portada 4:5 para app
  logoUrl                String? // Logo independiente del motel para tarjetas públicas
  status                 MotelStatus @default(PENDING)
  isActive               Boolean     @default(false)
  contactName            String?
  contactEmail           String?
  contactPhone           String?
  adminContactName       String?
  adminContactEmail      String?
  adminContactPhone      String?
  operationsContactName  String?
  operationsContactEmail String?
  operationsContactPhone String?
  plan                   PlanType    @default(BASIC)
  nextBillingAt          DateTime?
  isFeatured             Boolean     @default(false)
  ratingAvg              Float       @default(0)
  ratingCount            Int         @default(0)

  // Campos financieros
  billingDay         Int? // Día del mes para cobro (1-31)
  paymentType        PaymentType? // Tipo de cobro
  financialStatus    FinancialStatus @default(ACTIVE)
  billingCompanyName String? // Razón Social
  billingTaxId       String? // RUC

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rooms          RoomType[]
  menuCategories MenuCategory[]
  reviews        Review[]
  schedules      Schedule[]
  paymentMethods PaymentMethod[]
  socialLinks    SocialLink[]
  promos         Promo[]
  users          User[] // Usuarios administradores del motel
  analytics      MotelAnalytics[] // Eventos de analytics
  paymentHistory PaymentHistory[]
  reports        MotelReport[]

  @@index([status, isActive, createdAt])
  @@index([status, isActive, city])
  @@index([financialStatus, status, isActive])
}

// ============================================
// LOCATION CATALOG
// ============================================

model CountryCatalog {
  id             String        @id @default(cuid())
  name           String
  normalizedName String        @unique
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  cities         CityCatalog[]
}

model CityCatalog {
  id             String         @id @default(cuid())
  country        CountryCatalog @relation(fields: [countryId], references: [id], onDelete: Restrict)
  countryId      String
  name           String
  normalizedName String
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([countryId, normalizedName])
  @@index([countryId, isActive])
}

// ============================================
// PAYMENT HISTORY
// ============================================

model PaymentHistory {
  id          String        @id @default(cuid())
  motel       Motel         @relation(fields: [motelId], references: [id], onDelete: Cascade)
  motelId     String
  amount      Int
  currency    String        @default("PYG")
  paidAt      DateTime      @default(now())
  status      PaymentStatus @default(PAID)
  paymentType PaymentType?
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([motelId, paidAt])
}

// ============================================
// ROOM TYPE
// ============================================

model RoomType {
  id          String  @id @default(cuid())
  motel       Motel   @relation(fields: [motelId], references: [id], onDelete: Cascade)
  motelId     String
  name        String
  slug        String?
  description String?

  // Precios por tiempo
  price1h      Int?
  price1_5h    Int?
  price2h      Int?
  price3h      Int?
  price12h     Int?
  price24h     Int?
  priceNight   Int?
  customPrices String? // JSON para variantes futuras

  // Características
  maxPersons Int?
  hasJacuzzi Boolean @default(false)
  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  // Orden de aparición entre habitaciones del motel
  order Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // Relations
  amenities    RoomAmenity[]
  reviews      Review[]
  roomPhotos   RoomPhoto[]
  dayRates     RoomDayRate[]
  weekdayRates RoomWeekdayRate[]

  @@index([motelId, isActive, order])
}

// ============================================
// ROOM DAY RATES (precios por día de semana)
// ============================================

model RoomDayRate {
  id         String   @id @default(cuid())
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  roomTypeId String
  dayGroup   DayGroup
  price1h    Int?
  price1_5h  Int?
  price2h    Int?
  price3h    Int?
  price12h   Int?
  price24h   Int?
  priceNight Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([roomTypeId, dayGroup])
}

/// Sobrescribe una duración concreta en un día concreto. El admin puede cargar
/// varios días juntos; la API los guarda como filas individuales para evitar
/// ambigüedades y poder combinar reglas libremente.
model RoomWeekdayRate {
  id         String            @id @default(cuid())
  roomType   RoomType          @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  roomTypeId String
  weekday    Weekday
  duration   RoomPriceDuration
  price      Int
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([roomTypeId, weekday, duration])
  @@index([roomTypeId, weekday])
}

// ============================================
// AMENITY
// ============================================

model Amenity {
  id          String    @id @default(cuid())
  name        String    @unique
  icon        String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  // Relations
  roomAmenities RoomAmenity[]
}

// Room Amenity (join table)
model RoomAmenity {
  id         String   @id @default(cuid())
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  roomTypeId String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  amenityId  String

  @@unique([roomTypeId, amenityId])
}

// Room Photo (galería de fotos de habitación)
model RoomPhoto {
  id         String   @id @default(cuid())
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  roomTypeId String
  url        String // Variante con marca de agua para la web pública
  appUrl     String? // Variante limpia para las apps nativas
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([roomTypeId, order])
}

// ============================================
// MENU
// ============================================

model MenuCategory {
  id        String    @id @default(cuid())
  motel     Motel     @relation(fields: [motelId], references: [id], onDelete: Cascade)
  motelId   String
  name      String?
  slug      String?
  order     Int       @default(0)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // Relations
  items MenuItem[]

  // Legacy
  title     String?
  sortOrder Int?
}

model MenuItem {
  id          String       @id @default(cuid())
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  product     Product?     @relation(fields: [productId], references: [id])
  productId   String?
  name        String
  slug        String?
  description String?
  price       Int
  photoUrl    String?
  createdAt   DateTime?    @default(now())
  updatedAt   DateTime?    @updatedAt
}

// ============================================
// PRODUCTS (catálogo global)
// ============================================

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  defaultPrice    Int
  defaultPhotoUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  menuItems MenuItem[]
}

// ============================================
// REVIEWS / RATINGS
// ============================================

model Review {
  id          String    @id @default(cuid())
  motel       Motel?    @relation(fields: [motelId], references: [id], onDelete: Cascade)
  motelId     String?
  roomType    RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  roomTypeId  String?
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?
  score       Int // 1-5
  comment     String?
  isVerified  Boolean   @default(false) // True si el usuario está verificado
  isAnonymous Boolean   @default(false) // True si la review es anónima
  likes       Int       @default(0) // Para futuro: sistema de likes
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([motelId, createdAt])
  @@index([userId, motelId])
}

// ============================================
// USERS
// ============================================

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String? // Nullable para OAuth users
  name              String?
  birthDate         DateTime?
  role              UserRole       @default(USER)
  isActive          Boolean        @default(true)
  modulePermissions String[]       @default([])
  accessProfile     AccessProfile? @relation(fields: [accessProfileId], references: [id], onDelete: SetNull)
  accessProfileId   String?

  // Campos para usuarios móviles
  phone           String?
  profilePhoto    String?
  provider        String? @default("email") // "email", "google", "apple"
  providerId      String? // ID del proveedor OAuth
  isEmailVerified Boolean @default(false)

  // Tokens para notificaciones push
  pushToken  String? // Expo push token
  deviceInfo Json? // Info del dispositivo (OS, version, etc)

  // Relación con motel (para MOTEL_ADMIN)
  motel   Motel?  @relation(fields: [motelId], references: [id], onDelete: Cascade)
  motelId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  reviews                 Review[]
  favorites               Favorite[]
  auditLogs               AuditLog[]
  notificationPreferences UserNotificationPreferences?
  pushTokens              PushToken[]
  motelReports            MotelReport[]     @relation("MotelReportReporter")
  assignedMotelReports    MotelReport[]     @relation("MotelReportAssignee")
  motelReportNotes        MotelReportNote[]

  @@index([email])
  @@index([provider, providerId])
  @@index([accessProfileId])
}

model MotelReport {
  id        String            @id @default(cuid())
  motel     Motel             @relation(fields: [motelId], references: [id], onDelete: Cascade)
  motelId   String
  user      User?             @relation("MotelReportReporter", fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  assignedTo User?            @relation("MotelReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?
  reason    MotelReportReason
  comment   String?
  status    MotelReportStatus @default(PENDING)
  resolutionSummary String?
  resolvedAt DateTime?
  notes     MotelReportNote[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([motelId, createdAt])
  @@index([userId, createdAt])
  @@index([assignedToId, status])
}

model MotelReportNote {
  id        String      @id @default(cuid())
  report    MotelReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId  String
  body      String
  createdAt DateTime    @default(now())

  @@index([reportId, createdAt])
  @@index([authorId, createdAt])
}

model AppUpdateEvent {
  id            String          @id @default(cuid())
  action        AppUpdateAction
  platform      String
  currentVersion String
  targetVersion String?
  createdAt     DateTime        @default(now())

  @@index([action, createdAt])
  @@index([platform, currentVersion, createdAt])
}

// Perfiles configurables. Los roles del enum se conservan como clasificación
// y compatibilidad; el perfil define los permisos efectivos por módulo.
model AccessProfile {
  id          String                    @id @default(cuid())
  key         String                    @unique
  name        String
  description String?
  isSystem    Boolean                   @default(false)
  baseRole    UserRole
  isActive    Boolean                   @default(true)
  permissions AccessProfilePermission[]
  users       User[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([baseRole, isActive])
}

model AccessProfilePermission {
  id        String             @id @default(cuid())
  profile   AccessProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  module    String
  actions   PermissionAction[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([profileId, module])
  @@index([module])
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  module     String?
  method     String?
  path       String?
  statusCode Int?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, createdAt])
}

// ============================================
// FAVORITES (a futuro)
// ============================================

model Favorite {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  motelId    String?
  roomTypeId String?
  createdAt  DateTime @default(now())

  @@unique([userId, motelId])
}

// ============================================
// USER NOTIFICATION PREFERENCES
// ============================================

model UserNotificationPreferences {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  // Preferencias por categoría de push
  enableAdvertisingPush Boolean @default(true) // Push de Publicidad (puede desactivar)
  enableSecurityPush    Boolean @default(true) // Push de Seguridad (siempre se envía)
  enableMaintenancePush Boolean @default(true) // Push de Mantenimiento (siempre se envía)

  // Preferencias generales (legacy - mantener compatibilidad)
  enableNotifications Boolean @default(true)
  enableEmail         Boolean @default(true)
  enablePush          Boolean @default(true)

  // Alertas de favoritos (usuarios normales)
  notifyNewPromos  Boolean @default(true) // Nuevas promos en favoritos
  notifyPriceDrops Boolean @default(true) // Bajadas de precio
  notifyUpdates    Boolean @default(true) // Actualizaciones de motel

  // Alertas de reviews
  notifyReviewReplies Boolean @default(true) // Respuestas a mis reviews
  notifyReviewLikes   Boolean @default(false) // Likes en mis reviews

  // Marketing
  notifyPromotions Boolean @default(true) // Promociones generales
  notifyNewMotels  Boolean @default(false) // Nuevos moteles cerca

  // Preferencias para administradores (SUPERADMIN y MOTEL_ADMIN)
  notifyContactMessages  Boolean @default(true) // Mensajes de contacto
  notifyNewProspects     Boolean @default(true) // Nuevos prospectos
  notifyPaymentReminders Boolean @default(true) // Recordatorios de pago
  notifyMotelApprovals   Boolean @default(true) // Aprobaciones de motel pendientes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// WHATSAPP OTP
// ============================================

model WhatsappOtp {
  id          String    @id @default(cuid())
  phone       String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  lockedUntil DateTime?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([phone, createdAt])
  @@index([phone, expiresAt])
}

// ============================================
// SCHEDULES (horarios del motel)
// ============================================

model Schedule {
  id        String   @id @default(cuid())
  motel     Motel    @relation(fields: [motelId], references: [id], onDelete: Cascade)
  motelId   String
  dayOfWeek Int // 0=Sunday, 1=Monday, etc.
  openTime  String? // "09:00"
  closeTime String? // "22:00"
  is24Hours Boolean  @default(false)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// PAYMENT METHODS
// ============================================

model PaymentMethod {
  id        String   @id @default(cuid())
  motel     Motel    @relation(fields: [motelId], references: [id], onDelete: Cascade)
  motelId   String
  method    String // "CASH", "CARD", "TRANSFER", etc.
  createdAt DateTime @default(now())
}

// ============================================
// SOCIAL LINKS
// ============================================

model SocialLink {
  id        String   @id @default(cuid())
  motel     Motel    @relation(fields: [motelId], references: [id], onDelete: Cascade)
  motelId   String
  platform  String // "INSTAGRAM", "TIKTOK", "X", etc.
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// PROMOS (promociones especiales)
// ============================================

model Promo {
  id              String           @id @default(cuid())
  motel           Motel            @relation(fields: [motelId], references: [id], onDelete: Cascade)
  motelId         String
  title           String
  description     String?
  imageUrl        String?
  validFrom       DateTime?
  validUntil      DateTime?
  isActive        Boolean          @default(true)
  isGlobal        Boolean          @default(false)
  hasPromoCode    Boolean          @default(false)
  codeRepeatRule  CodeRepeatRule?
  codeLimit       Int?
  codeLimitPeriod CodeLimitPeriod?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  promoCodes PromoCode[]

  @@index([motelId, isActive, validFrom, validUntil])
}

model PromoCode {
  id         String          @id @default(cuid())
  promo      Promo           @relation(fields: [promoId], references: [id], onDelete: Cascade)
  promoId    String
  code       String          @unique
  deviceId   String
  status     PromoCodeStatus @default(PENDING)
  redeemedAt DateTime?
  redeemedBy String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([promoId, deviceId])
  @@index([code])
  @@index([promoId, status])
}

// ============================================
// HOME BANNERS (carrusel de la home)
// ============================================

model HomeBanner {
  id          String    @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  linkUrl     String?
  motelId     String? // Opcional, si el banner es específico de un motel
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================
// MOTEL PROSPECTS (leads de registro)
// ============================================

model MotelProspect {
  id          String          @id @default(cuid())
  contactName String?
  phone       String?
  email       String?
  motelName   String
  status      ProspectStatus  @default(NEW)
  channel     ProspectChannel @default(WEB)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
}

// ============================================
// MOTEL ANALYTICS (sistema de vistas y tracking)
// ============================================

model MotelAnalytics {
  id        String             @id @default(cuid())
  motel     Motel              @relation(fields: [motelId], references: [id], onDelete: Cascade)
  motelId   String
  eventType AnalyticsEventType
  timestamp DateTime           @default(now())

  // Metadatos del evento
  source      String? // 'MAP', 'LIST', 'SEARCH', 'HOME', 'DETAIL'
  userCity    String? // Ciudad del usuario (si está disponible)
  userCountry String? // País del usuario
  deviceType  String? // 'MOBILE', 'WEB'

  // Campos opcionales para contexto adicional
  metadata Json? // Información adicional flexible

  @@index([motelId, timestamp])
  @@index([motelId, eventType])
  @@index([motelId, eventType, timestamp])
  @@index([timestamp])
}

// ============================================
// ADVERTISEMENTS
// ============================================

model Advertisement {
  id               String      @id @default(cuid())
  title            String
  advertiser       String
  imageUrl         String
  largeImageUrl    String?
  largeImageUrlWeb String?
  largeImageUrlApp String?
  description      String?
  linkUrl          String?
  placement        AdPlacement
  status           AdStatus    @default(ACTIVE)
  priority         Int         @default(0)
  startDate        DateTime?
  endDate          DateTime?
  viewCount        Int         @default(0)
  clickCount       Int         @default(0)
  maxViews         Int?
  maxClicks        Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  analytics AdAnalytics[]
}

model AdAnalytics {
  id              String        @id @default(cuid())
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  advertisementId String
  eventType       AdEventType
  timestamp       DateTime      @default(now())
  deviceType      String?
  userCity        String?
  userCountry     String?
  source          String?

  @@index([advertisementId, timestamp])
  @@index([eventType, timestamp])
}

// ============================================
// CONTACT MESSAGES (Inbox del admin)
// ============================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([isRead, createdAt])
}

// ============================================
// PUSH TOKENS (notificaciones push)
// ============================================

model PushToken {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String?
  token      String   @unique // Expo push token
  deviceId   String? // Identificador único del dispositivo
  deviceType String? // "ios", "android"
  deviceName String? // Nombre del dispositivo
  appVersion String? // Versión de la app
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@index([isActive])
}

// ============================================
// SCHEDULED NOTIFICATIONS (notificaciones programadas)
// ============================================

model ScheduledNotification {
  id    String @id @default(cuid())
  title String
  body  String
  data  Json? // Datos adicionales para la notificación

  // Programación
  scheduledFor DateTime // Cuándo se debe enviar
  sent         Boolean   @default(false)
  sentAt       DateTime? // Cuándo se envió realmente

  // Audience (a quién se envía)
  targetUserIds String[] // IDs específicos de usuarios (opcional)
  targetRole    String? // "SUPERADMIN", "MOTEL_ADMIN", "USER" (opcional)
  targetMotelId String? // Si es para usuarios que favoritearon un motel

  // Categoría de notificación
  category String @default("advertising") // "advertising", "security", "maintenance"

  // Metadata
  type            String // "promo", "reminder", "announcement", etc.
  relatedEntityId String? // ID de la promo, motel, etc.

  // Resultados
  totalSent    Int     @default(0)
  totalFailed  Int     @default(0)
  totalSkipped Int     @default(0) // Usuarios que desactivaron esa categoría
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduledFor, sent])
  @@index([targetMotelId])
  @@index([type])
  @@index([category])
}

// ============================================
// AUTO NOTIFICATION CONFIG (configuración de notificaciones automáticas)
// ============================================

model AutoNotificationConfig {
  id          String   @id @default(cuid())
  key         String   @unique // ej: "contact_message", "promo_favorites", "new_prospect"
  enabled     Boolean  @default(false)
  label       String
  description String
  category    String // "advertising" | "security" | "maintenance"
  updatedAt   DateTime @updatedAt
  updatedBy   String? // userId del SUPERADMIN que lo cambió
}

// ============================================
// SETTINGS (configuraciones globales del sistema)
// ============================================

model Settings {
  id          String   @id @default(cuid())
  key         String   @unique // Clave única para la configuración
  value       String? // Valor (string, boolean, number como string)
  category    String   @default("general") // Categoría: "general", "features", "legal", etc.
  description String? // Descripción de la configuración
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// ============================================
// VISITOR ANALYTICS (estadísticas anónimas de usuarios)
// ============================================

model VisitorEvent {
  id        String   @id @default(cuid())
  deviceId  String // UUID anónimo por dispositivo/browser (persiste hasta desinstalar/limpiar datos)
  platform  String // "web" | "ios" | "android"
  event     String // "session_start" | "page_view" | "motel_view" | "search" | "screen_view"
  path      String? // Ruta web (ej: "/moteles/hotel-abc") o nombre de pantalla en app
  referrer  String? // Referrer web (de dónde viene el usuario)
  metadata  Json? // Contexto extra (motelId, ciudad, query de búsqueda, etc.)
  createdAt DateTime @default(now())

  @@index([deviceId])
  @@index([event])
  @@index([platform])
  @@index([createdAt])
  @@index([deviceId, createdAt])
  @@index([event, createdAt])
}
